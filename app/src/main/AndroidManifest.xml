<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Parkkar">
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Parkkar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:label="Sign Up"
            android:theme="@style/Theme.Parkkar" />
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:label="Home"
            android:theme="@style/Theme.Parkkar" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:label="Forgot Password"
            android:theme="@style/Theme.Parkkar" />
        <activity
            android:name=".ParkingResultsActivity"
            android:label="Parking Results"
            android:theme="@style/Theme.Parkkar" />
        <activity
            android:name=".MapActivity"
            android:exported="false"
            android:label="Map"
            android:theme="@style/Theme.Parkkar" />
        <activity
            android:name=".ChatbotActivity"
            android:exported="false"
            android:label="Chatbot"
            android:theme="@style/Theme.Parkkar" />
        <activity
            android:name=".BookingConfirmationActivity"
            android:exported="false"
            android:label="Booking Confirmation"
            android:theme="@style/Theme.Parkkar" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="Profile"
            android:theme="@style/Theme.Parkkar" />
        <activity
            android:name=".PersonalDetailsActivity"
            android:exported="false"
            android:label="Personal Details"
            android:theme="@style/Theme.Parkkar" />
        <activity
            android:name=".BookingHistoryActivity"
            android:exported="false"
            android:label="Booking History"
            android:theme="@style/Theme.Parkkar" />
        <activity
            android:name=".FavoriteSpotsActivity"
            android:exported="false"
            android:label="Favorite Spots"
            android:theme="@style/Theme.Parkkar" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:theme="@style/Theme.Parkkar" />
        <activity
            android:name=".HelpAndSupportActivity"
            android:exported="false"
            android:label="Help &amp; Support"
            android:theme="@style/Theme.Parkkar" />
    </application>

</manifest>